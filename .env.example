# Copy this file to .env in the repository root and replace the placeholders.
# Keep .env private; Git ignores it.

# Portkey credential for the OpenAI-backed shop chatbot.
PORTKEY_API_KEY=your_portkey_api_key_here

# Generate your own value using the command in README.md.
CAMPUS_CUSTOMS_SESSION_SECRET=replace_with_a_long_random_secret

# Use false for local HTTP; use true when serving the app over HTTPS.
CAMPUS_CUSTOMS_COOKIE_SECURE=false

# Optional: defaults to data/campus_customs.db relative to this repository.
# Use an absolute path if overriding the database location.
# CAMPUS_CUSTOMS_DATABASE_PATH=/absolute/path/to/campus_customs.db
